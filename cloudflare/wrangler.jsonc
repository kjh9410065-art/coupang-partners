{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "coupang-partners-automation",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",

  // 생성된 블로그 콘텐츠를 Cloudflare에 저장합니다.
  "kv_namespaces": [
    {
      "binding": "CONTENT_STORE"
    }
  ],

  // 한국시간 매일 오전 9시(UTC 00:00)에 하루 한 편만 자동 생성합니다.
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
