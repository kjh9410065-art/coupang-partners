{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "coupang-partners-automation",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",

  // 생성된 블로그 콘텐츠를 Cloudflare에 저장합니다.
  "kv_namespaces": [
    {
      "binding": "CONTENT_STORE"
    }
  ],

  // 초기 실제 생성 테스트와 매일 오전 9시(한국시간) 자동 생성을 함께 사용합니다.
  "triggers": {
    "crons": ["*/5 * * * *", "0 0 * * *"]
  }
}
