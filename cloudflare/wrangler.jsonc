{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "coupang-partners-automation",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",

  // 한국어 상품 글 생성에 사용하는 Cloudflare Workers AI 바인딩입니다.
  "ai": {
    "binding": "AI"
  },

  // 생성된 블로그 콘텐츠를 Cloudflare에 저장합니다.
  "kv_namespaces": [
    {
      "binding": "CONTENT_STORE"
    }
  ],

  // 한국시간 오전 9시/10시, 오후 2시/3시, 오후 6시/7시에 생성 및 실패 재시도합니다.
  // 각 시간대 원고는 하루 최대 1개만 저장합니다.
  "triggers": {
    "crons": ["0 0 * * *", "0 1 * * *", "0 5 * * *", "0 6 * * *", "0 9 * * *", "0 10 * * *"]
  }
}
