{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "coupang-partners",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",

  // 한국어 상품 글 생성에 사용하는 Cloudflare Workers AI 바인딩입니다.
  "ai": {
    "binding": "AI"
  },

  // 생성된 블로그 콘텐츠를 Cloudflare에 저장합니다.
  "kv_namespaces": [
    {
      "binding": "CONTENT_STORE"
    }
  ],

  // 사용자 요청으로 모든 자동 생성 일정을 제거합니다.
  "triggers": {
    "crons": []
  }
}
