{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "coupang-partners-automation",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",

  // 기존 Workers AI 바인딩을 보존합니다. 현재 추천/초안 흐름은 AI를 호출하지 않습니다.
  "ai": {
    "binding": "AI"
  },

  // 생성된 블로그 콘텐츠를 Cloudflare에 저장합니다.
  "kv_namespaces": [
    {
      "binding": "CONTENT_STORE"
    }
  ],

  // 한국시간 매일 오전 9시(UTC 00:00)에 오늘의 추천 캐시를 준비합니다.
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
